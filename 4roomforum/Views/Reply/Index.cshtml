@{
    var replies = ViewBag.PaginationReplies as IEnumerable<ReplyDTO> ?? Enumerable.Empty<ReplyDTO>();
    var post = ViewBag.Post as PostDTO;
    var postedBy = ViewBag.UserPost as UserDTO;
    var getUser = ViewBag.GetUserReply as Func<int, Task<UserDTO>>;
    var getReply = ViewBag.MyFunction as Func<int, Task<ReplyDTO>>;
    var getLike = ViewBag.GetLikeReply as Func<int, int>;
    var getDislike = ViewBag.GetDisLikeReply as Func<int, int>;
    var checkReaction = ViewBag.CheckReaction as Func<(int replyId, int userId), Task<string>>;
    var currentPage = ViewBag.CurrentPage;
    var totalPages = ViewBag.TotalPages;
    var totalReplies = ViewBag.TotalReplies;
    var userId = ViewBag.UserId;
    var loginStatus = (bool)ViewBag.LoginStatus;
    var userRole = ViewBag.UserRole;

    ViewBag.Title = post?.PostTitle ?? "Post";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>Info:</strong> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<main class="container reply-page" data-post-id="@post?.Id" data-login="@loginStatus.ToString().ToLowerInvariant()">
    <section class="post-heading border-bottom mb-3 pb-2">
        <h1 class="fw-bold">@post?.PostTitle</h1>
        <p class="text-muted mb-0">
            Posted by <span class="text-primary fw-semibold">@postedBy?.UserName</span>
            @if (postedBy?.RoleId == 1)
            {
                <strong>#ADMIN</strong>
            }
            at @post?.PostDate
            @if (post?.IsEdited == true)
            {
                <span>(Edited)</span>
            }
        </p>
    </section>

    <section class="card mb-3">
        <div class="card-body">
            <p class="fs-5 mb-0">@post?.PostContent</p>
        </div>
    </section>

    <div class="post-actions border-bottom mb-4 pb-2 d-flex justify-content-end align-items-center gap-2">
        <button class="action-button like-button @(ViewBag.IsLikedByUser ? "liked" : "")"
                type="button" onclick="toggleLike(this)" aria-label="Like post">
            <i class="fa-solid fa-heart"></i> <span id="likeCount">@ViewBag.TotalLike</span>
        </button>
        <button class="action-button" id="openPostComposer" type="button" aria-label="Comment on post">
            <i class="fa-solid fa-comment"></i> <span>@totalReplies</span>
        </button>
        <button class="action-button" id="shareButton" type="button" aria-label="Share post">
            <i class="fa-solid fa-share"></i>
        </button>
    </div>

    <section class="composer-panel card mb-4" id="postComposer" hidden>
        <div class="card-body">
            <div class="composer-heading">
                <div>
                    <h2 class="h5 mb-1">Join the discussion</h2>
                    <p class="text-muted mb-0" id="composerContext">Comment on @postedBy?.UserName's post</p>
                </div>
                <button class="btn-close" type="button" data-close-composer aria-label="Close"></button>
            </div>
            <form class="reply-form mt-3" data-post-id="@post?.Id">
                <input type="hidden" name="PostId" value="@post?.Id">
                <input type="hidden" name="RepliedBy" value="@userId">
                <input type="hidden" name="ReplyToReply" value="">
                <textarea class="form-control" name="ReplyContent" rows="3" maxlength="2000"
                          placeholder="Write your comment..." required></textarea>
                <div class="invalid-feedback">Please enter a comment.</div>
                <div class="composer-footer">
                    <span class="text-muted small">Replies appear instantly for everyone viewing this post.</span>
                    <button class="btn btn-primary" type="submit">Post comment</button>
                </div>
            </form>
        </div>
    </section>

    <section aria-labelledby="commentsHeading">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0" id="commentsHeading">Comments</h2>
            <span class="text-muted small" id="connectionStatus" role="status">Connecting...</span>
        </div>
        <div id="commentsContainer">
            @foreach (var r in replies)
            {
                var user = await getUser!(r.RepliedBy);
                var parent = r.ReplyToReply.HasValue ? await getReply!(r.ReplyToReply.Value) : null;
                var parentUser = parent == null ? null : await getUser!(parent.RepliedBy);
                var reaction = loginStatus ? await checkReaction!((r.ReplyId, userId)) : "No selection";
                <article class="comment-item row mb-4" id="reply-@r.ReplyId" data-reply-id="@r.ReplyId">
                    <div class="col-md-2 text-center">
                        <div class="avatar">
                            <img src="/imgs/@user?.Avatar" alt="@user?.UserName avatar">
                        </div>
                        <p class="mt-2 fw-bold mb-0">
                            @user?.UserName
                            @if (user?.RoleId == 1)
                            {
                                <strong>#ADMIN</strong>
                            }
                        </p>
                    </div>
                    <div class="col-md-10">
                        <div class="card comment-card">
                            <div class="card-header bg-light d-flex align-items-center justify-content-between">
                                <strong class="post-time">Posted at @r.ReplyDate.ToString("M/d/yyyy, h:mm:ss tt") @(r.IsEdited ? " (Edited)" : "")</strong>
                                @if (loginStatus && (userRole == 1 || r.RepliedBy == userId))
                                {
                                    <div class="dropdown">
                                        <button class="more-option-btn" type="button" data-bs-toggle="dropdown" aria-label="Comment options">
                                            <i class="fa-solid fa-ellipsis-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><button class="dropdown-item edit-button" type="button" data-id="@r.ReplyId">Edit</button></li>
                                            <li><button class="dropdown-item delete-button" type="button" data-reply-id="@r.ReplyId">Delete</button></li>
                                        </ul>
                                    </div>
                                }
                            </div>
                            <div class="card-body">
                                @if (parent != null)
                                {
                                    <blockquote class="quoted-reply p-2 bg-light border rounded">
                                        <strong class="text-primary">@parentUser?.UserName said:</strong>
                                        <br>@parent.ReplyContent
                                    </blockquote>
                                }
                                <p class="reply-content mt-3 mb-0">@r.ReplyContent</p>
                            </div>
                            <div class="card-footer">
                                <div class="d-flex align-items-center gap-2">
                                    <button class="reaction-btn like-btn" data-reply-id="@r.ReplyId" type="button">
                                        <i class="@(reaction == "Like" ? "fa-solid" : "fa-regular") fa-thumbs-up"></i>
                                        <span class="like-count">@getLike!(r.ReplyId)</span>
                                    </button>
                                    <button class="reaction-btn dislike-btn" data-reply-id="@r.ReplyId" type="button">
                                        <i class="@(reaction == "Dislike" ? "fa-solid" : "fa-regular") fa-thumbs-down"></i>
                                        <span class="dislike-count">@getDislike!(r.ReplyId)</span>
                                    </button>
                                    <button class="reaction-btn comment-for-reply" data-reply-id="@r.ReplyId" data-user-name="@user?.UserName" type="button">
                                        <i class="fa-solid fa-comment"></i> Reply
                                    </button>
                                </div>
                                <form class="reply-form nested-reply-form mt-3" data-post-id="@post?.Id" data-parent-id="@r.ReplyId" hidden>
                                    <input type="hidden" name="PostId" value="@post?.Id">
                                    <input type="hidden" name="RepliedBy" value="@userId">
                                    <input type="hidden" name="ReplyToReply" value="@r.ReplyId">
                                    <textarea class="form-control" name="ReplyContent" rows="2" maxlength="2000" placeholder="Reply to @user?.UserName..." required></textarea>
                                    <div class="invalid-feedback">Please enter a reply.</div>
                                    <div class="text-end mt-2">
                                        <button class="btn btn-sm btn-outline-secondary cancel-nested-reply" type="button">Cancel</button>
                                        <button class="btn btn-sm btn-primary" type="submit">Post reply</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
        @if (!replies.Any())
        {
            <p class="text-muted" id="emptyComments">No comments yet. Start the conversation.</p>
        }
    </section>

    @if (totalPages > 0)
    {
        <nav aria-label="Reply pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?PostId=@post?.Id&page=@(currentPage - 1)" aria-label="Previous">&laquo;</a>
                </li>
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="?PostId=@post?.Id&page=@i">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="?PostId=@post?.Id&page=@(currentPage + 1)" aria-label="Next">&raquo;</a>
                </li>
            </ul>
        </nav>
    }
</main>

<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Delete comment?</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">This action cannot be undone.</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteButton">Delete</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
<script src="~/js/Comment.js"></script>

<style>
    .reply-page { max-width: 1100px; }
    .action-button, .reaction-btn, .more-option-btn { border: 0; background: transparent; color: inherit; padding: .45rem .6rem; border-radius: .4rem; }
    .action-button:hover, .reaction-btn:hover, .more-option-btn:hover { background: #f0f2f5; }
    .like-button.liked { color: #dc3545; }
    .composer-panel { border-color: #dbe5f0; background: #fbfcfe; }
    .composer-heading, .composer-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .avatar { width: 88px; height: 88px; margin: auto; overflow: hidden; border-radius: 50%; background: #ffc107; }
    .avatar img { width: 100%; height: 100%; object-fit: cover; }
    .comment-card { border: 0; box-shadow: 0 2px 12px rgba(30, 55, 90, .08); }
    .quoted-reply { font-size: .9rem; color: #5d6875; }
    .nested-reply-form { background: #f8f9fa; border-radius: .5rem; padding: .75rem; }
    .connection-online { color: #198754; }
    .connection-offline { color: #dc3545; }
    @@media (max-width: 767.98px) {
        .avatar { width: 56px; height: 56px; }
        .composer-footer { align-items: flex-end; flex-direction: column; }
    }
</style>
